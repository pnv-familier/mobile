{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "updates": {
    "enabled": true,
    "checkOnLaunch": "ALWAYS",
    "fallbackToCacheTimeout": 0
  },
  "submit": {
    "production": {}
  }
}
